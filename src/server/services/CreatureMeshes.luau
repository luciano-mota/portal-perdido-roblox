local function buildTemplate(name: string,parts: {any}): Model?
	local model=Instance.new("Model") model.Name=name
	for _,spec in parts do
		local ok,part=pcall(function()
			return AssetService:CreateMeshPartAsync("rbxassetid://"..spec[2])
		end)
		if not ok or not part then
			warn("[PortalPerdido][CreatureMeshes] Malha indisponível em "..name.."."..spec[1]..": "..tostring(part))
			model:Destroy()
			return nil
		end
		part.Name=spec[1]
		if spec[3]~="" then part.TextureID="rbxassetid://"..spec[3] end
		part.Size=Vector3.new(spec[4][1],spec[4][2],spec[4][3])
		part.CFrame=CFrame.new(table.unpack(spec[5]))
		part.Anchored=true part.CanCollide=false part.CanTouch=false part.CanQuery=false
		part.Parent=model
	end
	model:SetAttribute("RebuiltFromData",true)
	return model
end

-- Garante os templates no ServerStorage. Reconstrói em paralelo os que faltarem; devolve quantos
-- foram reconstruídos. Templates existentes (do lugar salvo) têm prioridade e não são tocados.
function Meshes.ensure(timeout: number?): number
	local pending=0 local rebuilt=0
	for name,parts in Meshes.Data do
		if ServerStorage:FindFirstChild(name) then continue end
		pending+=1
		task.spawn(function()
			local model=buildTemplate(name,parts)
			if model and not ServerStorage:FindFirstChild(name) then model.Parent=ServerStorage rebuilt+=1 end
			pending-=1
		end)
	end
	local started=os.clock()
	while pending>0 and os.clock()-started<(timeout or 20) do task.wait(0.1) end
	if rebuilt>0 then print(string.format("[PortalPerdido] %d template(s) de criatura reconstruído(s) a partir dos dados.",rebuilt)) end
	return rebuilt
end

return Meshes
